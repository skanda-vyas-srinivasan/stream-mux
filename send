#!/bin/zsh

set -euo pipefail

script_dir="${0:A:h}"
sender_app="$script_dir/build/macos/MultiAudioMac/SoundMux Sender.app"

if (( $# != 0 )); then
    print -u2 "Usage: send"
    exit 2
fi

if [[ ! -d "$sender_app" ]]; then
    print -u2 "SoundMux Sender is not built. Run the project build first."
    exit 1
fi

open "$sender_app"
